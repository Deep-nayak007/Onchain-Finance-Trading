# Deployed Brain API. Paper trading on Monad testnet; no venue orders.
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_CHAIN_ID=10143
EXPO_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_API_URL=https://leash-brain-api.onrender.com
# Leave blank to import Rails' deployed URLs from packages/shared/addresses.ts.
EXPO_PUBLIC_GATEWAY_URL=
EXPO_PUBLIC_ENVIO_URL=
# Reads the current tunnel URL; shared envioUrl is only the last-known fallback.
EXPO_PUBLIC_ENVIO_URL_POINTER=https://raw.githubusercontent.com/yashpy/Onchain-Finance-Trading/main/deploy/envio-url.txt
# Permanent team-selected domain. Rebuild native apps after association files are configured.
EXPO_PUBLIC_PASSKEY_RP_ID=leash-brain-api.onrender.com
EXPO_PUBLIC_EAS_PROJECT_ID=
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
