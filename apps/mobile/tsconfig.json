{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["react", "react-native", "node"],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./*"],
      "@leash/shared/canonical": ["../../packages/shared/src/canonical.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["ios", "android"]
}
