    "associations": "node scripts/associations.mjs",
    "ios:cached": "node scripts/ios-cache.mjs",
    "smoke": "node scripts/smoke.mjs",
    "capture": "node scripts/capture.mjs",
    "format": "prettier --write .",
    "video": "node scripts/video-preview.mjs",
    "mock:ios": "node scripts/start-mocks.mjs --ios",
    "mock:web": "node scripts/start-mocks.mjs --web"
  },
