ALCHEMY_NOTIFY_TOKEN=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Gas tank / drip
GAS_TANK_ADDRESS=
GAS_TANK_PRIVATE_KEY=
DRIP_MON=

# LLM (Qwen, OpenAI-compatible, JSON mode only)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_COMPILE=
LLM_MODEL_TICK=
LLM_MODE=
LLM_TIMEOUT_MS=

# Integrations
